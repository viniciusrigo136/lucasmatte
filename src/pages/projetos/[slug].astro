---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projetos, projectImage, projectMeta, type ProjectData } from '../../data/projetos';
import { site, contactHref, sectionHref, projectHref } from '../../data/site';

export function getStaticPaths() {
  return projetos.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;

const all = await Promise.all(
  project.images.map(async (img) => {
    const src = projectImage(project.slug, img.file);
    const large = await getImage({ src, width: Math.min(src.width, 2400), format: 'webp', quality: 80 });
    return { ...img, src, landscape: src.width > src.height, largeSrc: large.src };
  }),
);
const cover = all.find((i) => i.file === project.cover) ?? all[0];
const gallery = all.filter((i) => i !== cover);

// Galeria em linhas com alternância fixa: 7 + 5 colunas, 5 + 7, depois uma foto inteira
// (16:9). Nas linhas de duas fotos as duas têm a mesma altura, então as legendas ficam
// na mesma linha de base. A foto horizontal vai para a vaga larga; a linha inteira usa
// uma horizontal (sem uma disponível, segue com mais uma linha de duas).
type Foto = (typeof gallery)[number];
type Linha = { tipo: 'par-75' | 'par-57' | 'inteira'; items: Foto[] };
const linhas: Linha[] = [];
const ciclo = ['par-75', 'par-57', 'inteira'] as const;
let pares = 0;
for (let i = 0, r = 0; i < gallery.length; r++) {
  const tipo = ciclo[r % ciclo.length];
  const cur = gallery[i];
  const prox = gallery[i + 1];
  if ((tipo === 'inteira' && cur.landscape) || !prox) {
    linhas.push({ tipo: 'inteira', items: [cur] });
    i += 1;
    continue;
  }
  const larga = pares++ % 2 === 0 ? 0 : 1; // posição da vaga de 7 colunas
  let par = [cur, prox];
  // A horizontal ocupa a vaga larga.
  if (par[larga].landscape === false && par[1 - larga].landscape) par = [par[1], par[0]];
  linhas.push({ tipo: larga === 0 ? 'par-75' : 'par-57', items: par });
  i += 2;
}
let idx = 0;
const linhasNumeradas = linhas.map((l) => ({ ...l, items: l.items.map((it) => ({ ...it, i: idx++ })) }));

// Ficha técnica: só os dados que existem em projetos.ts.
const ficha = [
  { rotulo: 'Categoria', valor: project.category },
  { rotulo: 'Cidade', valor: project.location },
  { rotulo: 'Materiais', valor: project.materials?.join(', ') },
  { rotulo: 'Fotografias', valor: String(all.length) },
].filter((f): f is { rotulo: string; valor: string } => !!f.valor);

const og = await getImage({ src: cover.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const heroWide = cover.landscape;

const pos = projetos.findIndex((p) => p.slug === project.slug);
const next = projetos[(pos + 1) % projetos.length];
const nextCover = projectImage(next.slug, next.cover);
// Agrupa palavras curtas na mesma linha (ex.: "Casa de / campo").
const titleWords = project.title.split(' ').reduce<string[]>((lines, w) => {
  const last = lines[lines.length - 1];
  if (last && (last + ' ' + w).length <= 9) lines[lines.length - 1] = last + ' ' + w;
  else lines.push(w);
  return lines;
}, []);
---

<Base title={`${project.title} | ${site.name}`} description={`${project.title}: ${project.summary}`} ogImage={og.src} overlayHeader theme={project.theme}>
  <article class="case">
    <!-- 1–3. Hero, nome e ficha -->
    <header class="case-hero">
      <div class="case-hero__frame cover">
        <Picture
          src={cover.src}
          alt={cover.alt}
          widths={[800, 1280, 1920, 2400]}
          sizes="100vw"
          formats={['avif', 'webp']}
          quality={74}
          loading="eager"
          fetchpriority="high"
          class:list={['case-hero__img', { 'is-tall': !heroWide }]}
          style={`view-transition-name: foto-${project.slug}`}
        />
        <div class="case-hero__scrim" aria-hidden="true"></div>
      </div>

      <div class="case-hero__top wrap">
        <a href={sectionHref('projetos')} class="case-hero__back">Todos os projetos</a>
      </div>

      <div class="case-hero__title-wrap wrap">
        <h1 class="case-hero__title">
          {titleWords.map((w) => <span class="line">{w}</span>)}
        </h1>
      </div>
    </header>

    <!-- 5. Descrição -->
    <!-- Ficha técnica em 1–4, texto em 5–12 (sem ficha, o texto ocupa 1–8) -->
    <section class:list={['case-intro', 'wrap', { 'case-intro--sem-ficha': ficha.length === 0 }]} aria-label="Sobre o projeto">
      {
        ficha.length > 0 && (
          <dl class="case-intro__ficha">
            {ficha.map((f) => (
              <div>
                <dt>{f.rotulo}</dt>
                <dd>{f.valor}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="case-intro__texto">
        <p class="case-intro__summary">{project.summary}</p>
        <div class="case-intro__body">
          {project.description.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>

    <!-- 6. Galeria editorial -->
    <section class="gallery wrap" aria-label={`Galeria de fotos: ${project.title}`}>
      {
        linhasNumeradas.map((l) => (
          <div class:list={['g', `g--${l.tipo}`]}>
            {l.items.map((img, k) => (
              <button
                type="button"
                class:list={['g__item', l.tipo === 'inteira' ? 'g__item--inteira' : (l.tipo === 'par-75') === (k === 0) ? 'g__item--larga' : 'g__item--estreita']}
                data-lightbox-index={img.i}
                data-full={img.largeSrc}
                data-alt={img.alt}
                aria-label={`Ampliar foto ${img.i + 1} de ${gallery.length}: ${img.alt}`}
              >
                <span class="g__frame cover">
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    widths={l.tipo === 'inteira' ? [640, 960, 1400, 1920, 2400] : [420, 640, 900, 1200, 1600]}
                    sizes={l.tipo === 'inteira' ? '(min-width: 1850px) 1760px, 92vw' : '(min-width: 64rem) 55vw, 100vw'}
                    formats={['avif', 'webp']}
                    quality={72}
                  />
                </span>
                <span class="g__cap">{String(img.i + 1).padStart(2, '0')}</span>
              </button>
            ))}
          </div>
        ))
      }
    </section>

    <!-- 7. Detalhes + contato -->
    <section class="case-details wrap" aria-labelledby="detalhes-title">
      <h2 id="detalhes-title" class="case-details__title">
        <span class="line">Tem um espaço</span>
        <span class="line">em mente?</span>
      </h2>
      <dl class="case-details__list">
        <div><dt>Projeto</dt><dd>{project.title}</dd></div>
        <div><dt>Categoria</dt><dd>{project.category}</dd></div>
        {project.location && <div><dt>Cidade</dt><dd>{project.location}</dd></div>}
        <div><dt>Fotografias</dt><dd>{all.length}</dd></div>
      </dl>
      <a href={contactHref} class="link-lg case-details__link" target="_blank" rel="noopener">
        Iniciar conversa pelo WhatsApp<span class="visually-hidden"> (abre em nova aba)</span>
      </a>
    </section>

    <!-- 8. Próximo projeto -->
    <a href={projectHref(next.slug)} class="next">
      <span class="next__frame cover">
        <Picture
          src={nextCover}
          alt=""
          widths={[800, 1280, 1920]}
          sizes="100vw"
          formats={['avif', 'webp']}
          quality={68}
          class="next__img"
        />
      </span>
      <span class="next__content wrap">
        <span class="next__label">Próximo projeto</span>
        <span class="next__title">{next.title}</span>
        <span class="next__meta">{projectMeta(next)}</span>
      </span>
    </a>
  </article>

  <dialog class="lightbox" aria-label="Visualização ampliada da foto">
    <div class="lightbox__bar">
      <p class="lightbox__count" aria-live="polite"></p>
      <button type="button" class="lightbox__btn" data-close>Fechar</button>
    </div>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <div class="lightbox__nav">
      <button type="button" class="lightbox__btn" data-prev><span aria-hidden="true">←</span> Anterior</button>
      <button type="button" class="lightbox__btn" data-next>Próxima <span aria-hidden="true">→</span></button>
    </div>
  </dialog>
</Base>

<style>
  /* ——— Hero do case ——— */
  .case-hero {
    position: relative;
    height: clamp(36rem, 100svh, 70rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: var(--header-h);
    color: var(--on-primary);
    isolation: isolate;
  }
  .case-hero__frame {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--ink-deep);
  }
  .case-hero__frame :global(img.is-tall) {
    object-position: 50% 35%;
  }
  .case-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(20 18 16 / 0.72), rgb(20 18 16 / 0) 52%),
      linear-gradient(to bottom, rgb(20 18 16 / 0.55), rgb(20 18 16 / 0) 30%);
  }
  .case-hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
  }
  .case-hero__back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    text-decoration-color: rgb(243 239 231 / 0.5);
  }
  .case-hero__back:hover {
    text-decoration-color: currentColor;
  }
  .case-hero__title-wrap {
    grid-row: 3;
    padding-bottom: var(--space-block);
  }
  .case-hero__title {
    font-size: clamp(3.25rem, 1rem + 9vw, 10.5rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-wrap: initial;
  }
  /* Linhas pares recuam uma coluna da grade. */
  .case-hero__title .line:nth-child(2n) {
    padding-left: calc(var(--col) + var(--grid-gap));
  }

  /* ——— Ficha técnica (1–4) e texto (5–12) ——— */
  .case-intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-block);
    align-items: start;
    padding-block: var(--space-block);
  }
  .case-intro__ficha {
    grid-column: 1 / span 4;
    margin: 0;
    font-size: var(--step--1);
    border-top: 1px solid var(--border);
  }
  .case-intro__ficha div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-text);
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .case-intro__ficha dt {
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }
  .case-intro__ficha dd {
    margin: 0;
    text-align: right;
  }
  .case-intro__texto {
    grid-column: 5 / span 8;
    display: grid;
    gap: var(--space-block);
  }
  .case-intro--sem-ficha .case-intro__texto {
    grid-column: 1 / span 8;
  }
  .case-intro__summary {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1rem + 2.8vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .case-intro__body {
    display: grid;
    gap: var(--space-text);
    max-width: 60ch;
    color: var(--text-secondary);
  }

  /* ——— Galeria ———
     Linhas dentro do container: 7 + 5, 5 + 7 e uma foto inteira (16:9). Nas linhas de
     duas fotos, a altura é a de uma foto 3:4 em 5 colunas, igual para as duas. */
  .gallery {
    --linha-par: calc((5 * var(--col) + 4 * var(--grid-gap)) * 4 / 3);
    display: grid;
    row-gap: var(--space-block);
    padding-bottom: var(--space-block);
  }
  .g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
  }
  .g__item {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: zoom-in;
  }
  .g__item:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 4px;
  }
  .g__frame {
    display: block;
    background: var(--border);
  }
  .g__frame :global(img) {
    transition: transform 1.2s var(--ease-arch);
  }
  .g__cap {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: var(--step--1);
    color: var(--text-secondary);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .g__item:hover .g__frame :global(img) {
      transform: scale(1.03);
    }
  }
  .g--par-75 .g__item:first-child,
  .g--par-57 .g__item:last-child {
    grid-column: span 7;
  }
  .g--par-75 .g__item:last-child,
  .g--par-57 .g__item:first-child {
    grid-column: span 5;
  }
  .g--par-75 .g__frame,
  .g--par-57 .g__frame {
    height: var(--linha-par);
  }
  .g--inteira .g__item {
    grid-column: 1 / -1;
  }
  .g--inteira .g__frame {
    aspect-ratio: 16 / 9;
  }

  /* ——— Detalhes + contato ——— */
  .case-details {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-block);
    align-items: end;
    padding-block: var(--space-block);
    border-top: 1px solid var(--border);
  }
  .case-details__title {
    grid-column: 1 / span 7;
    font-size: clamp(2.5rem, 1rem + 5vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .case-details__list {
    grid-column: 9 / span 4;
    margin: 0;
    font-size: 0.9375rem;
  }
  .case-details__list div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--border);
  }
  .case-details__list dt {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }
  .case-details__list dd {
    margin: 0;
  }
  .case-details__link {
    grid-column: 9 / span 4;
    justify-self: start;
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
  }

  /* ——— Próximo projeto ——— */
  .next {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(90svh, 52rem);
    color: var(--on-primary);
    text-decoration: none;
    isolation: isolate;
    overflow: hidden;
  }
  .next__frame {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink-deep);
  }
  .next__frame :global(img) {
    opacity: 0.62;
    transition:
      transform 1.4s var(--ease-arch),
      opacity 1s var(--ease-arch);
  }
  .next__content {
    display: grid;
    gap: 1rem;
    padding-block: var(--space-block);
  }
  .next__label,
  .next__meta {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: rgb(243 239 231 / 0.78);
  }
  .next__title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 1rem + 8vw, 9rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    transition: transform 0.9s var(--ease-arch);
  }
  .next:hover .next__frame :global(img) {
    transform: scale(1.04);
    opacity: 0.72;
  }
  .next:hover .next__title {
    transform: translateX(10px);
  }
  .next:focus-visible {
    outline-offset: -6px;
  }

  /* ——— Lightbox ——— */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(24 22 20 / 0.98);
    color: var(--on-primary);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .lightbox::backdrop {
    background: rgb(24 22 20 / 0.9);
  }
  .lightbox__bar,
  .lightbox__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--gutter);
  }
  .lightbox__count {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--on-dark-muted);
  }
  .lightbox__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.75rem;
    min-height: 0;
    margin: 0;
    padding-inline: var(--gutter);
  }
  .lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .lightbox__caption {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    font-size: var(--step--1);
    color: var(--on-dark-muted);
  }
  .lightbox__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgb(243 239 231 / 0.35);
    border-radius: 0;
    background: transparent;
    color: var(--on-primary);
    font: 500 var(--step--1)/1 var(--font-sans);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }
  .lightbox__btn:hover {
    background: rgb(243 239 231 / 0.1);
    border-color: var(--on-primary);
  }

  /* ——— Tablet e celular: uma coluna, mesma margem e mesma escala ——— */
  @media (max-width: 63.99rem) {
    .case-hero {
      height: auto;
      min-height: 88svh;
    }
    .case-intro__ficha,
    .case-intro__texto,
    .case-intro--sem-ficha .case-intro__texto,
    .case-details__title,
    .case-details__list,
    .case-details__link {
      grid-column: 1 / -1;
    }
    .g {
      row-gap: var(--space-block);
    }
    .g .g__item.g__item {
      grid-column: 1 / -1;
    }
    .g--par-75 .g__frame,
    .g--par-57 .g__frame {
      height: auto;
    }
    .g__item--larga .g__frame {
      aspect-ratio: 4 / 3;
    }
    .g__item--estreita .g__frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-index]'));

  if (dialog && items.length) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox__count')!;
    let current = 0;
    let trigger: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const item = items[current];
      img.src = item.dataset.full!;
      img.alt = item.dataset.alt!;
      caption.textContent = item.dataset.alt!;
      count.textContent = `${current + 1} de ${items.length}`;
      // Pré-carrega a próxima foto para a navegação pelas setas não piscar.
      const proxima = items[(current + 1) % items.length];
      if (proxima) new Image().src = proxima.dataset.full!;
    };

    items.forEach((item, i) =>
      item.addEventListener('click', () => {
        trigger = item;
        show(i);
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('[data-close]')!.focus();
      }),
    );

    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    // Setas navegam; Tab circula só entre os botões do diálogo (o <dialog> nativo deixa
    // o foco escapar para a interface do navegador).
    const botoes = Array.from(dialog.querySelectorAll<HTMLButtonElement>('button'));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'Tab') {
        e.preventDefault();
        const i = botoes.indexOf(document.activeElement as HTMLButtonElement);
        const proximo = (i + (e.shiftKey ? -1 : 1) + botoes.length) % botoes.length;
        botoes[proximo].focus();
      }
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('.lightbox__figure')) dialog.close();
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      trigger?.focus();
    });
  }
</script>
