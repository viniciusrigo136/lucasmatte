---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjetoDestaque from '../components/ProjetoDestaque.astro';
import ProjetosGrade from '../components/ProjetosGrade.astro';
import AreasAtuacao from '../components/AreasAtuacao.astro';
import ComoTrabalhamos from '../components/ComoTrabalhamos.astro';
import Depoimentos from '../components/Depoimentos.astro';
import { projetos } from '../data/projetos';
import { site, contactHref } from '../data/site';
import retrato from '../assets/sobre/lucas-matte-retrato.jpg';
import ogSrc from '../assets/projetos/igreja/dsc09501.jpg';

const og = await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const { instagram, email } = site.contact;
// Cidade, alcance e CAU do escritório: cada item só aparece se estiver em site.ts.
const credenciais = [site.cidade, site.atuacao, site.cau && `CAU ${site.cau}`].filter(Boolean) as string[];

// O projeto em destaque abre a seção; os demais formam a grade, na ordem de projetos.ts.
const destaques = projetos.filter((p) => p.featured);
const demais = projetos.filter((p) => !p.featured);

---

<Base ogImage={og.src} overlayHeader heroLogo>
  <Hero />

  <div class="stage">

  <!-- Filosofia -->
  <section id="manifesto" class="manifesto" aria-labelledby="manifesto-title">
    <div class="wrap manifesto__grid">
      <h2 id="manifesto-title" class="manifesto__title">Arquitetura nasce do encontro entre espaço, matéria e pessoas.</h2>
      <div class="manifesto__aside">
        <span class="manifesto__rule" aria-hidden="true"></span>
        <h3 class="manifesto__sub">Cada espaço começa com uma forma de viver.</h3>
        <p class="manifesto__text">
          Antes de materiais e formas, vem o jeito de usar a casa, o trabalho, o encontro. É a partir dessa rotina
          que estética e funcionalidade se ajustam, até o espaço fazer sentido para quem vive nele.
        </p>
      </div>
    </div>
  </section>

  <!-- Projetos: destaque (Decorare) + grade. A passagem pelo destaque é o segundo
       momento de movimento do site: a página vai do marfim ao preto e volta. -->
  <section id="projetos" class="projects" aria-labelledby="projetos-title">
    <div class="wrap projects__head">
      <SectionHeading lines={['Projetos']} id="projetos-title" class="projects__title" />
    </div>
    {destaques.map((project) => <ProjetoDestaque project={project} />)}
    <div class="projects__grade">
      <ProjetosGrade projects={demais} />
    </div>
    <p class="wrap projects__convite">
      Tem um projeto em mente?
      <a href={contactHref} class="text-link" target="_blank" rel="noopener">
        Conversar pelo WhatsApp<span class="visually-hidden"> (abre em nova aba)</span>
      </a>
    </p>
  </section>

  <!-- Escritório -->
  <section id="escritorio" class="about" aria-labelledby="escritorio-title">
    <div class="wrap about__grid">
      <div class="about__text">
        <SectionHeading lines={['Um olhar atento ao que torna cada projeto único.']} id="escritorio-title" />
        <p class="about__lead">
          Lucas Matté Arquitetura desenvolve projetos residenciais, comerciais e de interiores.
        </p>
        <p>
          Nos trabalhos reunidos aqui, madeira, pedra, vegetação e luz quente aparecem como matéria de projeto — de uma
          casa de campo em tijolo aparente a uma igreja desenhada pela iluminação.
        </p>
        {/* Cada item fica inteiro (espaços inquebráveis); a linha só quebra depois de um "·". */}
        {credenciais.length > 0 && <p class="about__credenciais">{credenciais.map((c) => c.replace(/ /g, '\u00a0')).join('\u00a0· ')}</p>}
        <a href={instagram.url} class="text-link" target="_blank" rel="noopener">
          Acompanhe no Instagram {instagram.handle}<span class="visually-hidden"> (abre em nova aba)</span>
        </a>
      </div>
      <figure class="about__portrait">
        <div class="about__frame cover">
          <Picture
            src={retrato}
            alt="Retrato de Lucas Matté sentado diante de uma parede de vegetação, vestindo camiseta preta."
            widths={[420, 640, 900, 1200]}
            sizes="(min-width: 64rem) 36vw, 100vw"
            formats={['avif', 'webp']}
            quality={72}
          />
        </div>
        <figcaption class="about__caption">Lucas Matté, arquiteto</figcaption>
      </figure>
    </div>
  </section>

  <!-- Atuação -->
  <AreasAtuacao />

  <!-- Como trabalhamos e Depoimentos: só aparecem com dados em site.ts -->
  <ComoTrabalhamos />
  <Depoimentos />

  <!-- Contato -->
  <section id="contato" class="cta" aria-labelledby="contato-title">
    <div class="wrap cta__inner">
      <h2 id="contato-title" class="cta__title">
        <span class="line">Vamos criar algo</span>
        <span class="line">que permaneça.</span>
      </h2>
      <div class="cta__foot">
        <p class="cta__text">
          Conte o que você imagina — uma casa, um ambiente, um negócio. A conversa começa pelo jeito como você quer viver
          ou usar o espaço.
        </p>
        <div class="cta__actions">
          <a href={contactHref} class="link-lg" target="_blank" rel="noopener">
            <span class="link-lg__texto">Conversar pelo WhatsApp</span><span class="visually-hidden"> (abre em nova aba)</span>
          </a>
          <ul class="cta__secundarios">
            <li>
              <a href={instagram.url} class="text-link" target="_blank" rel="noopener">
                Instagram {instagram.handle}<span class="visually-hidden"> (abre em nova aba)</span>
              </a>
            </li>
            {email && <li><a href={`mailto:${email}`} class="text-link">{email}</a></li>}
          </ul>
        </div>
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  /* Sem fundo próprio: deixa aparecer a cor do body, que muda na passagem pelo destaque. */
  .stage {
    background: transparent;
  }

  /* ——— Filosofia ———
     Título em 1–8; o bloco de apoio em 7–12, logo abaixo (um --space-block). */
  .manifesto {
    padding-block: var(--space-section) var(--space-block);
  }
  .manifesto__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-block);
  }
  .manifesto__title {
    grid-column: 1 / span 8;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 6.25rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .manifesto__aside {
    grid-column: 7 / span 6;
    display: grid;
    gap: var(--space-text);
  }
  .manifesto__sub {
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .manifesto__text {
    color: var(--text-secondary);
    max-width: 40ch;
  }
  .manifesto__rule {
    display: block;
    height: 1px;
    background: var(--text-primary);
  }

  /* ——— Projetos ———
     Do fim da Filosofia ao título: um --space-section (block + block). */
  .projects {
    padding-block: var(--space-block);
  }
  .projects__head {
    margin-bottom: var(--space-block);
  }
  .projects__grade {
    margin-top: var(--space-block);
  }
  /* Convite discreto ao fim do portfólio: a conversa sem precisar descer até o contato. */
  .projects__convite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    margin-top: var(--space-block);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--text-secondary);
  }
  .projects__convite .text-link {
    color: var(--text-primary);
  }

  /* ——— Escritório ———
     Mesmo fundo do site; a foto alinha o topo com o topo do título. */
  .about {
    padding-block: var(--space-block);
    background: var(--background);
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-block);
    align-items: start;
  }
  .about__text {
    grid-column: 1 / span 6;
    display: grid;
    gap: var(--space-text);
    justify-items: start;
    color: var(--text-secondary);
  }
  .about__text :global(.sh) {
    text-wrap: balance;
    font-size: clamp(2.5rem, 1rem + 4.4vw, 6rem);
    color: var(--text-primary);
  }
  .about__lead {
    max-width: 30ch;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    line-height: 1.3;
    color: var(--text-primary);
  }
  .about__text > p:not(.about__lead) {
    max-width: 44ch;
  }
  .about__credenciais {
    font-size: var(--step--1);
    color: var(--text-primary);
  }
  .about__portrait {
    grid-column: 8 / span 5;
    margin: 0;
  }
  .about__frame {
    aspect-ratio: 4 / 5;
  }
  .about__frame :global(img) {
    object-position: 50% 30%;
  }
  .about__caption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--text-secondary);
  }

  /* ——— Contato ——— */
  .cta {
    padding-block: var(--space-block);
    background: var(--primary);
    color: var(--on-primary);
  }
  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-block);
  }
  /* Cada linha do título fica inteira em qualquer largura. O tamanho segue a largura do
     container (cqw): "que permaneça." ocupa 7,6em e, somada ao recuo de duas colunas
     (≈ 1/6 da largura), cabe com folga em 10,5cqw; "Vamos criar algo" ocupa 7,85em. */
  .cta__title {
    font-size: min(10rem, 10.5cqw);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }
  .cta__title .line {
    white-space: nowrap;
  }
  /* A segunda linha recua exatamente duas colunas da grade. */
  .cta__title .line:nth-child(2) {
    padding-left: calc(2 * (var(--col) + var(--grid-gap)));
  }
  .cta__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-block);
    align-items: end;
    padding-top: var(--space-block);
    border-top: 1px solid rgb(243 239 231 / 0.18);
  }
  .cta__text {
    grid-column: 1 / span 5;
    max-width: 40ch;
    color: rgb(243 239 231 / 0.78);
  }
  .cta__actions {
    grid-column: 7 / span 6;
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }
  .cta__secundarios {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    --link-line: var(--bronze-on-dark);
    color: var(--on-dark-muted);
  }

  /* ——— Tablet e celular: tudo em uma coluna, mesma margem e mesma escala ——— */
  @media (max-width: 63.99rem) {
    .manifesto__title,
    .manifesto__aside,
    .about__portrait,
    .about__text,
    .cta__text,
    .cta__actions {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .manifesto__aside {
      max-width: 34rem;
    }
    .about__portrait {
      width: min(100%, 30rem);
    }
    /* Recuo de uma coluna (≈ 1/12 da largura): cabe em 11,5cqw. */
    .cta__title {
      font-size: 11.5cqw;
    }
    .cta__title .line:nth-child(2) {
      padding-left: calc(var(--col) + var(--grid-gap));
    }
  }

  /* ——— Passagem pelo destaque: marfim → preto → marfim ———
     Enquanto o bloco do Decorare atravessa o meio da tela, a página inteira entra no
     tema escuro (body[data-theme='dark'], ligado pelo script abaixo): o fundo de tudo o
     que está visível vai ao preto em 0,8s e todos os textos trocam de cor de uma vez, no
     meio da gradação. Nenhum texto fica parado sobre um tom intermediário, e o bloco
     não tem fundo próprio, então não há faixa de outra cor ao redor dele.
     As variáveis de cor são registradas (@property, em global.css) para poderem ser
     animadas. Com movimento reduzido, a troca é imediata. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.passagem-destaque body) {
      transition:
        --background 0.8s ease,
        --surface 0.8s ease,
        background-color 0.8s ease,
        --text-primary 0s linear 0.4s,
        --text-secondary 0s linear 0.4s,
        --border 0s linear 0.4s;
    }
    :global(.site-header[data-hero-logo]) {
      transition: background-color 0.8s ease;
    }
  }
  :global(html.decorare-ativo .site-header[data-hero-logo][data-compact='true']:not(.is-open)) {
    background-color: var(--decorare-black);
  }
</style>

<script>
  // Sem JS, o bloco do Decorare já nasce preto (data-theme do próprio bloco). Com JS, ele
  // passa a seguir o tema da página, que fica escuro enquanto o bloco cruza a faixa
  // central da tela (de 45% a 55% da altura).
  const destaque = document.querySelector<HTMLElement>('[data-destaque][data-theme="dark"]');
  if (destaque && 'IntersectionObserver' in window) {
    const html = document.documentElement;
    destaque.removeAttribute('data-theme');
    html.classList.add('passagem-destaque');
    new IntersectionObserver(
      ([entrada]) => {
        const ativo = entrada.isIntersecting;
        if (ativo) document.body.dataset.theme = 'dark';
        else delete document.body.dataset.theme;
        html.classList.toggle('decorare-ativo', ativo);
      },
      { rootMargin: '-45% 0px -45% 0px' },
    ).observe(destaque);
  }
</script>
