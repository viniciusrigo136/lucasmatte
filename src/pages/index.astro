---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectShowcase, { type ShowcaseLayout } from '../components/ProjectShowcase.astro';
import AreasAtuacao from '../components/AreasAtuacao.astro';
import { projetos, getProject } from '../data/projetos';
import { site, contactHref } from '../data/site';
import retrato from '../assets/sobre/lucas-matte-retrato.jpg';
import ogSrc from '../assets/projetos/igreja/dsc09501.jpg';

const og = await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

// Ritmo propositalmente irregular: cada projeto tem uma composição própria.
const showcase: { slug: string; layout: ShowcaseLayout; secondary?: string; image?: string }[] = [
  { slug: 'casa-de-campo', layout: 'left' },
  { slug: 'casa-erechim', layout: 'right', secondary: 'dsc08514.jpg' },
  { slug: 'casa-nova-erechim', layout: 'full' },
  { slug: 'decorare', layout: 'pair', secondary: 'dsc08742.jpg' },
  { slug: 'igreja', layout: 'cinema', image: 'dji-0950.jpg' },
];
const featured = showcase.map((s) => ({ ...s, project: getProject(s.slug)! }));
// Projetos novos adicionados aos dados entram no fim, alternando composições.
const extraLayouts: ShowcaseLayout[] = ['left', 'right', 'full'];
const extras = projetos
  .filter((p) => !showcase.some((s) => s.slug === p.slug))
  .map((project, i) => ({ slug: project.slug, layout: extraLayouts[i % 3], project, secondary: undefined, image: undefined }));
const all = [...featured, ...extras];
const total = String(all.length).padStart(2, '0');
const categories = [...new Set(all.map((s) => s.project.category))].join(', ');

---

<Base ogImage={og.src} overlayHeader heroLogo>
  <Hero />

  <div class="stage">

  <!-- Filosofia -->
  <section id="manifesto" class="manifesto" aria-labelledby="manifesto-title">
    <div class="wrap manifesto__grid">
      <h2 id="manifesto-title" class="manifesto__title">Arquitetura nasce do encontro entre espaço, matéria e pessoas.</h2>
      <div class="manifesto__aside">
        <span class="manifesto__rule" aria-hidden="true"></span>
        <h3 class="manifesto__sub">Cada espaço começa com uma forma de viver.</h3>
        <p class="manifesto__text">
          Antes de materiais e formas, vem o jeito de usar a casa, o trabalho, o encontro. É a partir dessa rotina
          que estética e funcionalidade se ajustam, até o espaço fazer sentido para quem vive nele.
        </p>
      </div>
    </div>
  </section>

  <!-- Projetos -->
  <section id="projetos" class="projects" aria-labelledby="projetos-title">
    <div class="wrap projects__head">
      <SectionHeading lines={['Projetos']} id="projetos-title" />
      <p class="projects__count">
        <span>{total}</span> {categories}
      </p>
    </div>

    <div class="projects__list">
      {all.map((s) => <ProjectShowcase project={s.project} layout={s.layout} secondary={s.secondary} image={s.image} />)}
    </div>
  </section>

  <!-- Escritório -->
  <section id="sobre" class="about" aria-labelledby="sobre-title">
    <p class="about__vertical" aria-hidden="true">Arquitetura</p>
    <div class="wrap about__grid">
      <div class="about__head">
        <SectionHeading lines={['Um olhar atento', 'ao que torna cada', 'projeto único.']} id="sobre-title" />
      </div>
      <figure class="about__portrait">
        <div class="about__frame cover">
          <Picture
            src={retrato}
            alt="Retrato de Lucas Matté sentado diante de uma parede de vegetação, vestindo camiseta preta."
            widths={[420, 640, 900, 1200]}
            sizes="(min-width: 64rem) 36vw, 100vw"
            formats={['avif', 'webp']}
            quality={72}
          />
        </div>
        <figcaption class="about__caption">Lucas Matté</figcaption>
      </figure>
      <div class="about__text">
        <p class="about__lead">
          Lucas Matté Arquitetura desenvolve projetos residenciais, comerciais e de interiores.
        </p>
        <p>
          Nos trabalhos reunidos aqui, madeira, pedra, vegetação e luz quente aparecem como matéria de projeto — de uma
          casa de campo em tijolo aparente a uma igreja desenhada pela iluminação.
        </p>
        <a href={site.contact.instagram.url} class="text-link" target="_blank" rel="noopener">
          Acompanhe no Instagram {site.contact.instagram.handle}
          <span class="visually-hidden">(abre em nova aba)</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Atuação -->
  <AreasAtuacao />

  <!-- Contato -->
  <section id="contato" class="cta" aria-labelledby="contato-title">
    <div class="wrap cta__inner">
      <h2 id="contato-title" class="cta__title">
        <span class="line">Vamos criar algo</span>
        <span class="line">que permaneça.</span>
      </h2>
      <div class="cta__foot">
        <p class="cta__text">
          Conte o que você imagina — uma casa, um ambiente, um negócio. A conversa começa pelo jeito como você quer viver
          ou usar o espaço.
        </p>
        <div class="cta__actions">
          <a href={contactHref} class="link-lg" target="_blank" rel="noopener">
            Iniciar conversa<span class="visually-hidden"> pelo WhatsApp (abre em nova aba)</span>
          </a>
          <a href={site.contact.instagram.url} class="text-link cta__ig" target="_blank" rel="noopener">
            Instagram {site.contact.instagram.handle}<span class="visually-hidden"> (abre em nova aba)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  .stage {
    background: var(--background);
  }

  /* ——— Manifesto ——— */
  .manifesto {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(6rem, 16vw, 13rem);
    overflow: clip;
  }
  .manifesto__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2.5rem, 6vw, 5rem);
  }
  .manifesto__title {
    grid-column: 1 / span 10;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 6.25rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .manifesto__aside {
    grid-column: 8 / span 4;
    display: grid;
    gap: 1.25rem;
  }
  .manifesto__sub {
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .manifesto__text {
    color: var(--text-secondary);
    max-width: 40ch;
  }

  .manifesto__rule {
    display: block;
    height: 1px;
    background: var(--text-primary);
  }

  /* ——— Projetos ——— */
  .projects {
    padding-bottom: clamp(5rem, 12vw, 10rem);
  }
  .projects__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(4rem, 9vw, 8rem);
  }
  .projects__count {
    max-width: 18rem;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-align: right;
  }
  .projects__count span {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: 0;
    color: var(--text-primary);
  }
  .projects__list {
    display: grid;
    gap: clamp(7rem, 16vw, 14rem);
  }

  /* ——— Escritório ——— */
  .about {
    position: relative;
    padding-block: clamp(6rem, 14vw, 12rem);
    background: var(--surface);
    overflow: clip;
  }
  .about__vertical {
    position: absolute;
    top: 50%;
    right: -0.12em;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(5rem, 13vw, 13rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    writing-mode: vertical-rl;
    transform: translateY(-50%) rotate(180deg);
    pointer-events: none;
    user-select: none;
  }
  .about__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(3rem, 6vw, 5rem);
  }
  .about__head {
    grid-column: 1 / span 8;
    grid-row: 1;
    position: relative;
    z-index: 1;
  }
  .about__head :global(.sh) {
    font-size: clamp(2.5rem, 1rem + 5vw, 6.5rem);
  }
  .about__portrait {
    grid-column: 9 / span 4;
    grid-row: 1 / span 2;
    margin: 0;
    margin-top: clamp(6rem, 16vw, 14rem);
  }
  .about__frame {
    aspect-ratio: 4 / 5;
  }
  .about__frame :global(img) {
    object-position: 50% 30%;
  }
  .about__caption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .about__text {
    grid-column: 2 / span 5;
    grid-row: 2;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    align-self: start;
    color: var(--text-secondary);
    max-width: 34rem;
  }
  .about__lead {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    line-height: 1.3;
    color: var(--text-primary);
  }

  /* ——— CTA final ——— */
  .cta {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: clamp(6rem, 12vw, 9rem);
    background: var(--primary);
    color: var(--on-primary);
  }
  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .cta__title {
    font-size: clamp(3.25rem, 1rem + 9vw, 10rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-wrap: initial;
  }
  .cta__title .line:nth-child(2) {
    padding-left: clamp(1rem, 12vw, 14rem);
  }
  .cta__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: 2.5rem;
    align-items: end;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid rgb(243 239 231 / 0.18);
  }
  .cta__text {
    grid-column: 1 / span 5;
    max-width: 40ch;
    color: rgb(243 239 231 / 0.78);
  }
  .cta__actions {
    grid-column: 8 / span 5;
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }
  .cta__ig {
    --link-line: var(--bronze-on-dark);
    color: var(--on-dark-muted);
  }

  /* ——— Telas médias e celular ——— */
  @media (max-width: 63.99rem) {
    .manifesto__title,
    .manifesto__aside {
      grid-column: 1 / -1;
    }
    .manifesto__aside {
      max-width: 34rem;
    }
    .about__head,
    .about__portrait,
    .about__text,
    .cta__text,
    .cta__actions {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .about__portrait {
      margin-top: 0;
      width: min(100%, 30rem);
    }
    .about__vertical {
      display: none;
    }
    .cta {
      min-height: 88svh;
    }
  }
</style>
