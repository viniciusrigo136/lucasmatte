---
import Logo from './Logo.astro';
import { site } from '../data/site';

interface Props {
  /** Começa sobre uma foto escura (textos claros) e passa a creme ao rolar. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
// Números acompanham as seções da home.
const nav = [
  { href: `${home}#projetos`, label: 'Projetos', n: '02' },
  { href: `${home}#sobre`, label: 'Sobre', n: '03' },
  { href: `${home}#atuacao`, label: 'Atuação', n: '04' },
  { href: `${home}#contato`, label: 'Contato', n: '05' },
];
const ctaHref = site.contact.whatsapp ?? site.contact.instagram.url;
---

<header class="site-header" data-compact="false" data-overlay={overlay ? 'true' : 'false'}>
  <div class="site-header__inner">
    <a href={home} class="site-header__brand" aria-label="Lucas Matté Arquitetura, página inicial">
      <Logo tone="both" width={168} eager class="site-header__logo" />
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul class="site-nav__list">
        {nav.map((item) => <li><a href={item.href} class="site-nav__link">{item.label}</a></li>)}
      </ul>
      <a href={ctaHref} class="site-nav__cta" target="_blank" rel="noopener">
        <span>Conversar sobre um projeto</span>
        <span class="site-nav__arrow" aria-hidden="true">↗</span>
        <span class="visually-hidden">(abre o WhatsApp em nova aba)</span>
      </a>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-mobile">
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="menu-mobile" id="menu-mobile" hidden>
    <nav aria-label="Principal (celular)">
      <ul class="menu-mobile__list">
        {
          nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={item.href} class="menu-mobile__link">
                <span class="menu-mobile__n" aria-hidden="true">{item.n}</span>
                <span class="menu-mobile__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-mobile__foot" style="--i: 4">
      <a href={ctaHref} class="btn" target="_blank" rel="noopener">
        Conversar sobre um projeto <span class="btn__arrow" aria-hidden="true">↗</span>
        <span class="visually-hidden">(abre o WhatsApp em nova aba)</span>
      </a>
      <a href={site.contact.instagram.url} class="text-link" target="_blank" rel="noopener">
        Instagram {site.contact.instagram.handle}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--text-primary);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.6s var(--ease-arch),
      border-color 0.6s var(--ease-arch),
      color 0.6s var(--ease-arch);
  }
  .site-header[data-compact='true'] {
    background: rgb(243 239 231 / 0.96);
    border-bottom-color: rgb(48 45 41 / 0.1);
  }
  /* Desfoque mínimo apenas em telas grandes (é caro em celulares) */
  @media (hover: hover) and (pointer: fine) {
    .site-header[data-compact='true'] {
      background: rgb(243 239 231 / 0.86);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: var(--max);
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
    transition: height 0.6s var(--ease-arch);
  }
  .site-header[data-compact='true'] .site-header__inner {
    height: var(--header-h-compact);
  }

  .site-header__brand {
    display: block;
    flex-shrink: 0;
    transform-origin: left center;
    transition: transform 0.6s var(--ease-arch);
  }
  .site-header[data-compact='true'] .site-header__brand {
    transform: scale(0.84);
  }
  .site-header__brand :global(.site-header__logo) {
    width: clamp(124px, 11vw, 158px);
  }
  .site-header__brand :global(.logo__img) {
    transition: opacity 0.6s var(--ease-arch);
  }
  .site-header__brand :global(.logo__img--light) {
    opacity: 0;
  }

  /* Sobre a foto: textos e logo claros */
  .site-header[data-overlay='true'][data-compact='false']:not(.is-open) {
    color: var(--on-primary);
  }
  .site-header[data-overlay='true'][data-compact='false']:not(.is-open) .site-header__brand :global(.logo__img--dark) {
    opacity: 0;
  }
  .site-header[data-overlay='true'][data-compact='false']:not(.is-open) .site-header__brand :global(.logo__img--light) {
    opacity: 1;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .site-nav__list {
    display: flex;
    gap: clamp(1.5rem, 2.6vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.7s var(--ease-arch);
  }
  .site-nav__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding-block: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .site-nav__cta > span:first-child {
    transition: transform 0.6s var(--ease-arch);
  }
  .site-nav__arrow {
    display: inline-block;
    transition: transform 0.6s var(--ease-arch);
  }
  .site-nav__cta:hover > span:first-child {
    transform: translateX(-2px);
  }
  .site-nav__cta:hover .site-nav__arrow {
    transform: translate(3px, -3px);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0 0.25rem 0 0.75rem;
    margin-right: -0.25rem;
    border: 0;
    background: none;
    color: inherit;
    font: 500 0.75rem/1 var(--font-sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .menu-toggle__bars {
    display: grid;
    gap: 6px;
    width: 26px;
  }
  .menu-toggle__bars span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--ease-arch);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ——— Menu em tela cheia (creme) ——— */
  .menu-mobile {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: calc(var(--header-h) + 1.5rem) var(--gutter) max(2rem, env(safe-area-inset-bottom));
    background: var(--background);
    color: var(--text-primary);
    overflow-y: auto;
  }
  .menu-mobile[hidden] {
    display: none;
  }
  .menu-mobile__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-mobile__list li {
    border-bottom: 1px solid var(--border);
  }
  .menu-mobile__link {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1rem 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 12vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .menu-mobile__label {
    transition: transform 0.4s var(--ease-arch);
  }
  .menu-mobile__link:active .menu-mobile__label {
    transform: translateX(6px);
  }
  .menu-mobile__n {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .menu-mobile__foot {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .menu-mobile__foot .text-link {
    color: var(--text-secondary);
  }

  .site-header.is-open {
    color: var(--text-primary);
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-mobile:not([hidden]) {
      animation: menu-in 0.75s var(--ease-arch) both;
    }
    .menu-mobile:not([hidden]) .menu-mobile__list li,
    .menu-mobile:not([hidden]) .menu-mobile__foot {
      animation: menu-item 0.9s var(--ease-arch) calc(0.15s + var(--i, 0) * 0.07s) both;
    }
    .menu-mobile.is-closing {
      animation: menu-out 0.48s cubic-bezier(0.7, 0, 0.84, 0) both;
    }
    .menu-mobile.is-closing .menu-mobile__list li,
    .menu-mobile.is-closing .menu-mobile__foot {
      animation: menu-item-out 0.3s ease-in both;
    }
    /* Entrada da marca na carga da página */
    .site-header__brand,
    .site-nav,
    .menu-toggle {
      animation: header-in 1.1s var(--ease-arch) var(--header-delay, 0.15s) both;
    }
    :global(html.is-preloading) .site-header {
      --header-delay: 1.1s;
    }
  }
  @keyframes menu-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes menu-out {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }
  @keyframes menu-item-out {
    to {
      opacity: 0;
      transform: translateY(-16px);
    }
  }
  @keyframes header-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (max-width: 60rem) {
    .site-nav {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.getElementById('menu-mobile');

  if (header && toggle && panel) {
    // Fundo creme e versão compacta depois dos primeiros pixels de rolagem.
    // Sobre a hero, só troca quando a foto já saiu quase toda da tela.
    const overlay = header.dataset.overlay === 'true';
    let ticking = false;
    const update = () => {
      const limit = overlay ? Math.max(24, window.innerHeight - header.offsetHeight - 8) : 24;
      header.dataset.compact = window.scrollY > limit ? 'true' : 'false';
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );

    const focusables = () =>
      Array.from(header.querySelectorAll<HTMLElement>('.site-header__brand, .menu-toggle, #menu-mobile a'));

    let closeTimer = 0;
    const setOpen = (open: boolean, returnFocus = true) => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('.menu-toggle__label')!.textContent = open ? 'Fechar' : 'Menu';
      window.clearTimeout(closeTimer);
      if (open) {
        panel.classList.remove('is-closing');
        panel.hidden = false;
      } else if (reduce) {
        panel.hidden = true;
      } else {
        panel.classList.add('is-closing');
        closeTimer = window.setTimeout(() => {
          panel.hidden = true;
          panel.classList.remove('is-closing');
        }, 480);
      }
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      window.dispatchEvent(new CustomEvent(open ? 'lm:lock' : 'lm:unlock'));
      if (open) panel.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false, false);
    });

    document.addEventListener('keydown', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
      } else if (e.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    window.matchMedia('(min-width: 60.0625rem)').addEventListener('change', (e) => {
      if (e.matches && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, false);
    });
  }
</script>
