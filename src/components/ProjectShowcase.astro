---
import { Picture } from 'astro:assets';
import { projectImage, type ProjectData } from '../data/projetos';

export type ShowcaseLayout = 'left' | 'right' | 'full' | 'pair' | 'cinema';

interface Props {
  project: ProjectData;
  n: string;
  layout: ShowcaseLayout;
  /** Foto secundária (arquivo do próprio projeto) para composições em camadas. */
  secondary?: string;
  /** Foto principal alternativa à capa (arquivo do próprio projeto). */
  image?: string;
}

const { project, n, layout, secondary, image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/projetos/${project.slug}/`;
const mainFile = image ?? project.cover;
const cover = project.images.find((i) => i.file === mainFile) ?? project.images[0];
// A foto compartilha nome de transição com a página do projeto apenas quando é a capa.
const vtStyle = mainFile === project.cover ? `view-transition-name: foto-${project.slug}` : undefined;
const second = secondary ? project.images.find((i) => i.file === secondary) : undefined;

const mainSizes: Record<ShowcaseLayout, string> = {
  left: '(min-width: 64rem) 64vw, 100vw',
  right: '(min-width: 64rem) 58vw, 100vw',
  full: '100vw',
  pair: '(min-width: 64rem) 40vw, 100vw',
  cinema: '100vw',
};
const mainWidths = layout === 'full' || layout === 'cinema' ? [800, 1280, 1920, 2400] : [640, 960, 1400, 1920];
---

<article class:list={['sc', `sc--${layout}`]} aria-labelledby={`sc-${project.slug}`}>
  <a href={href} class="sc__media" data-cursor="Ver projeto" tabindex="-1" aria-hidden="true">
    <div class="sc__frame reveal-img" data-reveal-img>
      <div class="sc__scale">
        <div class="sc__drift" data-drift="8">
        <Picture
          src={projectImage(project.slug, cover.file)}
          alt=""
          widths={mainWidths}
          sizes={mainSizes[layout]}
          formats={['avif', 'webp']}
          quality={72}
          class="sc__img"
          style={vtStyle}
        />
        </div>
      </div>
    </div>
  </a>

  {
    second && (
      <a href={href} class="sc__second" data-cursor="Ver projeto" tabindex="-1" aria-hidden="true" data-drift="10">
        <div class="sc__frame reveal-img" data-reveal-img>
          <div class="sc__scale">
            <Picture
              src={projectImage(project.slug, second.file)}
              alt=""
              widths={[420, 640, 900]}
              sizes="(min-width: 64rem) 26vw, 60vw"
              formats={['avif', 'webp']}
              quality={70}
              class="sc__img"
            />
          </div>
        </div>
      </a>
    )
  }

  <div class="sc__info">
    <p class="sc__n" data-reveal>{n}</p>
    <h3 id={`sc-${project.slug}`} class="sc__title" data-reveal-lines>
      <span class="line"><span class="line__inner">{project.title}</span></span>
    </h3>
    <dl class="sc__meta" data-reveal>
      <div>
        <dt class="visually-hidden">Categoria</dt>
        <dd>{project.category}</dd>
      </div>
      {
        project.location && (
          <div>
            <dt class="visually-hidden">Cidade</dt>
            <dd>{project.location}</dd>
          </div>
        )
      }
    </dl>
    <p class="sc__summary" data-reveal>{project.summary}</p>
    <a href={href} class="sc__link" data-reveal>
      Ver projeto<span class="visually-hidden">: {project.title}</span>
      <span class="sc__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .sc {
    --cols: repeat(12, minmax(0, 1fr));
    position: relative;
    display: grid;
    grid-template-columns: var(--cols);
    column-gap: clamp(1rem, 2vw, 2rem);
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .sc__media,
  .sc__second {
    display: block;
    position: relative;
    color: inherit;
  }
  .sc__frame {
    position: relative;
    height: 100%;
    background: var(--border);
  }
  .sc__scale {
    width: 100%;
    height: 100%;
  }
  .sc__frame :global(picture),
  .sc__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Parallax interno: a foto é um pouco maior que a moldura e desliza dentro dela */
  .sc__drift {
    height: 112%;
    margin-top: -6%;
    will-change: transform;
  }
  .sc__frame :global(img) {
    transition: transform 1.2s var(--ease-arch);
  }
  .sc__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(20 18 16 / 0);
    transition: background-color 0.9s var(--ease-arch);
    pointer-events: none;
  }

  .sc__info {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
  }
  .sc__n {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    color: var(--accent);
    padding-bottom: 0.75rem;
    min-width: 4rem;
    border-bottom: 1px solid currentColor;
  }
  .sc__title {
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.025em;
    transition: transform 0.9s var(--ease-arch);
  }
  .sc__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .sc__meta dd {
    margin: 0;
  }
  .sc__meta div + div::before {
    content: '/';
    margin-right: 1.5rem;
    opacity: 0.5;
  }
  .sc__summary {
    max-width: 32ch;
    color: var(--text-secondary);
  }
  .sc__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .sc__arrow {
    display: inline-block;
    transition: transform 0.7s var(--ease-arch);
  }
  .sc__link:hover .sc__arrow,
  .sc:has(.sc__media:hover) .sc__arrow {
    transform: translate(4px, -4px);
  }

  /* Toque: retorno visual rápido */
  .sc__media:active .sc__frame,
  .sc__second:active .sc__frame {
    transform: scale(0.99);
  }
  .sc__frame {
    transition: transform 0.3s var(--ease-arch);
  }

  @media (hover: hover) and (pointer: fine) {
    .sc:has(.sc__media:hover) .sc__media .sc__frame :global(img),
    .sc:has(.sc__second:hover) .sc__second .sc__frame :global(img) {
      transform: scale(1.04);
    }
    .sc:has(.sc__media:hover) .sc__media .sc__frame::after {
      background: rgb(20 18 16 / 0.08);
    }
    .sc:has(.sc__media:hover, .sc__link:hover) .sc__title {
      transform: translateY(-4px);
    }
  }

  /* ——— 01: imagem grande à esquerda, informações à direita, na base ——— */
  .sc--left .sc__media {
    grid-column: 1 / span 8;
    margin-left: calc(-1 * var(--gutter));
    aspect-ratio: 4 / 3;
    max-height: 86svh;
  }
  .sc--left .sc__info {
    grid-column: 10 / span 3;
    align-self: end;
  }

  /* ——— 02: vertical dominante à direita, sangrando a borda; texto no alto à esquerda ——— */
  .sc--right .sc__media {
    grid-column: 6 / span 7;
    grid-row: 1 / span 2;
    margin-right: calc(-1 * var(--gutter));
    height: min(92svh, 62rem);
  }
  .sc--right .sc__info {
    grid-column: 1 / span 4;
    grid-row: 1;
    padding-top: clamp(2rem, 8svh, 6rem);
  }
  .sc--right .sc__second {
    grid-column: 2 / span 3;
    grid-row: 2;
    align-self: end;
    aspect-ratio: 3 / 4;
    margin-bottom: -6rem;
    z-index: 1;
  }

  /* ——— 03: quase sangrada, informações sobrepostas em placa marfim ——— */
  .sc--full {
    padding-inline: 0;
    max-width: none;
  }
  .sc--full .sc__media {
    grid-column: 1 / -1;
    grid-row: 1;
    margin-inline: clamp(0rem, 3vw, 3rem);
    height: min(88svh, 60rem);
  }
  .sc--full .sc__info {
    grid-column: 1 / span 5;
    grid-row: 1;
    align-self: end;
    z-index: 1;
    margin-left: var(--gutter);
    margin-bottom: -3.5rem;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    background: var(--background);
  }

  /* ——— 04: duas verticais desencontradas; texto no alto à direita ——— */
  .sc--pair .sc__media {
    grid-column: 1 / span 5;
    grid-row: 1 / span 2;
    aspect-ratio: 4 / 5;
  }
  .sc--pair .sc__info {
    grid-column: 7 / span 5;
    grid-row: 1;
    padding-top: clamp(1rem, 4svh, 3rem);
  }
  .sc--pair .sc__second {
    grid-column: 8 / span 4;
    grid-row: 2;
    aspect-ratio: 3 / 4;
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  /* ——— 05: cinema, foto de ponta a ponta com o texto dentro dela ——— */
  .sc--cinema {
    padding-inline: 0;
    max-width: none;
    color: var(--on-primary);
  }
  .sc--cinema .sc__media {
    grid-column: 1 / -1;
    grid-row: 1;
    height: min(100svh, 64rem);
  }
  .sc--cinema .sc__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgb(20 18 16 / 0.65), rgb(20 18 16 / 0) 55%);
    pointer-events: none;
  }
  .sc--cinema .sc__info {
    grid-column: 1 / span 6;
    grid-row: 1;
    align-self: end;
    z-index: 2;
    padding: 0 var(--gutter) clamp(2rem, 6svh, 4.5rem);
    pointer-events: none;
  }
  .sc--cinema .sc__info > * {
    pointer-events: auto;
  }
  .sc--cinema .sc__n {
    color: var(--sand);
  }
  .sc--cinema .sc__title {
    font-size: var(--step-4);
  }
  .sc--cinema .sc__meta,
  .sc--cinema .sc__summary {
    color: rgb(243 239 231 / 0.82);
  }

  /* ——— Telas médias e celular: fotos praticamente de borda a borda ——— */
  @media (max-width: 63.99rem) {
    .sc {
      display: flex;
      flex-direction: column;
      padding-inline: 0;
    }
    .sc .sc__media {
      margin: 0 !important;
      width: 100%;
      height: auto !important;
      max-height: none;
      aspect-ratio: 4 / 5 !important;
    }
    .sc--left .sc__media,
    .sc--full .sc__media,
    .sc--cinema .sc__media {
      aspect-ratio: 4 / 3.4 !important;
    }
    .sc .sc__info {
      order: 2;
      margin: 0 !important;
      padding: 1.75rem var(--gutter) 0 !important;
      background: none !important;
    }
    .sc .sc__second {
      order: 3;
      width: 58%;
      align-self: flex-end;
      margin: 2rem var(--gutter) 0 !important;
    }
    .sc--cinema {
      color: var(--text-primary);
    }
    .sc--cinema .sc__frame::before {
      display: none;
    }
    .sc--cinema .sc__meta,
    .sc--cinema .sc__summary {
      color: var(--text-secondary);
    }
    .sc--cinema .sc__n {
      color: var(--accent);
    }
    .sc--cinema .sc__title {
      font-size: var(--step-3);
    }
  }
</style>
