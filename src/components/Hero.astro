---
import { getImage } from 'astro:assets';
import heroWide from '../assets/projetos/igreja/dsc09501.jpg';
import heroTall from '../assets/projetos/igreja/dsc09507.jpg';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const wideWidths = [960, 1440, 1920, 2400];
const tallWidths = [480, 750, 1080];

async function srcset(src: ImageMetadata, widths: number[], format: 'avif' | 'webp' | 'jpg') {
  const imgs = await Promise.all(widths.map((w) => getImage({ src, width: w, format, quality: format === 'jpg' ? 78 : 70 })));
  return imgs.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

const [wideAvif, wideWebp, tallAvif, tallWebp, fallback] = await Promise.all([
  srcset(heroWide, wideWidths, 'avif'),
  srcset(heroWide, wideWidths, 'webp'),
  srcset(heroTall, tallWidths, 'avif'),
  srcset(heroTall, tallWidths, 'webp'),
  getImage({ src: heroWide, width: 1920, format: 'jpg', quality: 78 }),
]);
const tallMedia = '(max-width: 47.99rem) and (orientation: portrait)';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <picture class="hero__media">
    <source media={tallMedia} type="image/avif" srcset={tallAvif} sizes="100vw" />
    <source media={tallMedia} type="image/webp" srcset={tallWebp} sizes="100vw" />
    <source type="image/avif" srcset={wideAvif} sizes="100vw" />
    <source type="image/webp" srcset={wideWebp} sizes="100vw" />
    <img
      src={fallback.src}
      width={heroWide.width}
      height={heroWide.height}
      alt="Fachada de igreja ao anoitecer: duas torres revestidas em pedra iluminadas e, ao centro, a empena com a cruz em destaque."
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__kicker hero-in" style="--d: 0.25s">{site.areas}</p>
    <h1 id="hero-title" class="hero__title hero-in" style="--d: 0.35s">
      <span>Arquitetura para viver.</span>
      <span>Espaços para sentir.</span>
    </h1>
    <p class="hero__lead hero-in" style="--d: 0.5s">
      Projetos que aproximam estética, funcionalidade e o seu jeito de viver.
    </p>
    <div class="hero__actions hero-in" style="--d: 0.6s">
      <a href="#projetos" class="btn btn--light">Conheça os projetos</a>
      <a href="#contato" class="btn btn--ghost-light">Vamos conversar</a>
    </div>
  </div>

  <div class="hero__foot">
    <a href="#introducao" class="hero__scroll">
      <span class="hero__scroll-line" aria-hidden="true"></span>
      Role para conhecer
    </a>
    <a href={`${base}/projetos/igreja/`} class="hero__credit">Na imagem: Igreja</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: max(34rem, min(100svh, 62rem));
    color: var(--on-primary);
    background: #1d1b19;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  /* Sombra localizada: base e canto inferior esquerdo, onde fica o texto; topo levemente escurecido para o header. */
  .hero__shade {
    background:
      linear-gradient(to top, rgb(22 20 18 / 0.78) 0%, rgb(22 20 18 / 0.35) 32%, rgb(22 20 18 / 0) 55%),
      radial-gradient(ellipse 70% 60% at 0% 100%, rgb(22 20 18 / 0.55), rgb(22 20 18 / 0) 70%),
      linear-gradient(to bottom, rgb(22 20 18 / 0.45) 0%, rgb(22 20 18 / 0) 18%);
  }

  .hero__content {
    align-self: end;
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding: calc(var(--header-h) + 3rem) var(--gutter) clamp(1.5rem, 4vh, 2.75rem);
  }

  .hero__kicker {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgb(243 239 231 / 0.88);
    margin-bottom: clamp(1rem, 2.4vh, 1.5rem);
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .hero__kicker::before {
    content: '';
    width: 2.25rem;
    height: 1px;
    background: var(--sand);
  }

  .hero__title {
    font-size: clamp(2.5rem, 1rem + 4.6vw, 5.25rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: initial;
  }
  .hero__title span {
    display: block;
  }
  @media (min-width: 48rem) {
    .hero__title span {
      white-space: nowrap;
    }
  }

  .hero__lead {
    max-width: 34ch;
    margin-top: clamp(1.25rem, 3vh, 1.75rem);
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgb(243 239 231 / 0.9);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 4vh, 2.25rem);
  }

  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: var(--max);
    width: 100%;
    margin-inline: auto;
    padding: 0 var(--gutter) 1rem;
    font-size: var(--step--1);
    color: rgb(243 239 231 / 0.78);
  }
  .hero__foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .hero__foot a:hover {
    color: var(--on-primary);
  }
  .hero__scroll-line {
    width: 1px;
    height: 1.75rem;
    background: currentColor;
    transform-origin: top;
  }
  .hero__credit {
    border-bottom: 1px solid transparent;
  }
  .hero__credit:hover {
    text-decoration: underline !important;
    text-underline-offset: 0.3em;
  }

  /* Entrada: imagem e texto, uma única vez. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__media img {
      animation: hero-img 1.1s var(--ease-out) both;
    }
    .hero-in {
      animation: hero-in 0.75s var(--ease-out) var(--d, 0s) both;
    }
    .hero__foot {
      animation: hero-fade 0.6s ease-out 0.9s both;
    }
  }
  @keyframes hero-img {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .hero {
      min-height: max(36rem, 100svh);
    }
    .hero__media img {
      object-position: 50% 40%;
    }
    .hero__shade {
      background:
        linear-gradient(to top, rgb(22 20 18 / 0.86) 0%, rgb(22 20 18 / 0.55) 38%, rgb(22 20 18 / 0) 62%),
        linear-gradient(to bottom, rgb(22 20 18 / 0.5) 0%, rgb(22 20 18 / 0) 20%);
    }
    .hero__title {
      font-size: clamp(2.375rem, 1.2rem + 5.4vw, 3.25rem);
    }
    .hero__actions .btn {
      flex: 1 1 12rem;
    }
    .hero__scroll {
      display: none !important;
    }
    .hero__foot {
      justify-content: flex-start;
    }
  }

  /* Telas baixas (notebooks, paisagem no celular) */
  @media (max-height: 40rem) and (min-width: 48rem) {
    .hero__title {
      font-size: clamp(2.5rem, 7vh, 4rem);
    }
    .hero__content {
      padding-top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
