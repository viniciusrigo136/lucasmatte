---
import { Picture } from 'astro:assets';
import LogoAnimada from './LogoAnimada.astro';
import { getProject, projectImage, projectMeta } from '../data/projetos';
import { projectHref } from '../data/site';

/**
 * Hero: uma foto de projeto em tela cheia com a logo no centro.
 * A entrada (foto assentando + logo letra a letra) é o único momento marcante do site.
 * Para trocar a foto, mude `slug` e `file` (arquivo do próprio projeto em projetos.ts).
 */
const destaque = { slug: 'casa-nova-erechim', file: 'dsc06978.jpg', pos: '50% 50%', mpos: '38% 50%' };

const project = getProject(destaque.slug)!;
const foto = project.images.find((i) => i.file === destaque.file)!;
---

<script is:inline>
  // Chegando de outra página do site, a logo já aparece pronta (sem repetir a entrada).
  try {
    if (document.referrer && new URL(document.referrer).origin === location.origin) {
      document.documentElement.classList.add('hero-skip');
    }
  } catch (e) {}
</script>

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media cover">
    <Picture
      src={projectImage(destaque.slug, destaque.file)}
      alt={foto.alt}
      widths={[480, 768, 1080, 1440, 1920, 2400]}
      sizes="100vw"
      formats={['avif', 'webp']}
      quality={70}
      loading="eager"
      fetchpriority="high"
      style={`--pos: ${destaque.pos}; --mpos: ${destaque.mpos}`}
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <h1 id="hero-title" class="hero__logo">
    <LogoAnimada entrada label="Lucas Matté Arquitetura" />
  </h1>

  <p class="hero__credit">
    <a href={projectHref(project.slug)}>{project.title}</a>
    <span>{projectMeta(project)}</span>
  </p>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    color: var(--on-primary);
    background: var(--ink-deep);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__media :global(img) {
    object-position: var(--pos, 50% 50%);
  }
  @media (max-width: 63.99rem) and (orientation: portrait) {
    .hero__media :global(img) {
      object-position: var(--mpos, 50% 50%);
    }
  }

  /* Escurece a foto o bastante para a logo marfim ter contraste em qualquer ponto. */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(ellipse 60% 50% at 50% 50%, rgb(20 18 16 / 0.35), rgb(20 18 16 / 0) 75%),
      linear-gradient(to bottom, rgb(20 18 16 / 0.5), rgb(20 18 16 / 0.42) 40%, rgb(20 18 16 / 0.58) 78%, rgb(20 18 16 / 0.78));
  }

  .hero__logo {
    width: min(78vw, 46rem);
    margin: 0;
    font: inherit;
  }

  .hero__credit {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    font-size: var(--step--1);
  }
  .hero__credit a {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: rgb(243 239 231 / 0.5);
    transition: text-decoration-color 0.3s;
  }
  .hero__credit a:hover {
    text-decoration-color: currentColor;
  }
  .hero__credit span {
    letter-spacing: 0.04em;
  }

  /* ——— Entrada: a foto assenta e clareia enquanto a logo se forma ———
     Faz parte do mesmo momento da logo (ver LogoAnimada.astro). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.hero-skip)) .hero__media {
      animation: hero-foto 2.6s var(--ease-arch) both;
    }
    :global(html:not(.hero-skip)) .hero__shade {
      animation: hero-sombra 2.2s ease-out both;
    }
    :global(html:not(.hero-skip)) .hero__credit {
      animation: hero-credito 0.9s var(--ease-arch) 1.7s both;
    }
  }
  @keyframes hero-foto {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes hero-sombra {
    from {
      background-color: rgb(20 18 16 / 0.45);
    }
    to {
      background-color: rgb(20 18 16 / 0);
    }
  }
  @keyframes hero-credito {
    from {
      opacity: 0;
    }
  }
</style>
