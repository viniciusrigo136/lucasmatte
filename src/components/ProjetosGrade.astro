---
import { Picture } from 'astro:assets';
import { projectImage, projectMeta, type ProjectData } from '../data/projetos';
import { projectHref } from '../data/site';

/**
 * Grade editorial dos projetos (exceto o destaque). Cada vaga tem posição e proporção
 * próprias, então os itens nunca formam uma grade de cards iguais; os projetos ocupam
 * as vagas na ordem de projetos.ts, e o padrão se repete se houver mais de quatro.
 */
interface Props {
  projects: ProjectData[];
}
const { projects } = Astro.props;

const vagas = [
  { cls: 'vaga--a', ratio: '4 / 3', sizes: '(min-width: 64rem) 56vw, 100vw' }, // grande, horizontal
  { cls: 'vaga--b', ratio: '4 / 5', sizes: '(min-width: 64rem) 40vw, 100vw' }, // grande, vertical
  { cls: 'vaga--c', ratio: '3 / 4', sizes: '(min-width: 64rem) 32vw, 80vw' }, // vertical estreita
  { cls: 'vaga--d', ratio: '16 / 9', sizes: '(min-width: 64rem) 56vw, 100vw' }, // horizontal larga
];
---

<ul class="wrap grade" role="list">
  {
    projects.map((project, i) => {
      const vaga = vagas[i % vagas.length];
      const capa = project.images.find((im) => im.file === project.cover) ?? project.images[0];
      return (
        <li class:list={['vaga', vaga.cls]}>
          <a href={projectHref(project.slug)} class="item" aria-label={project.title}>
            <span class="item__foto cover" style={`aspect-ratio: ${vaga.ratio}`}>
              <Picture
                src={projectImage(project.slug, capa.file)}
                alt=""
                widths={[480, 720, 960, 1280, 1600]}
                sizes={vaga.sizes}
                formats={['avif', 'webp']}
                quality={72}
                loading="lazy"
                style={`view-transition-name: foto-${project.slug}`}
              />
            </span>
            <span class="item__nome">{project.title}</span>
            <span class="item__meta">{projectMeta(project)}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .grade {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(4rem, 9vw, 8rem);
    margin: 0;
    padding-block: 0;
    list-style: none;
  }

  .item {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }
  .item__foto {
    display: block;
    margin-bottom: 0.9rem;
    background: var(--border);
  }
  .item__foto :global(img) {
    transition: transform 1.1s var(--ease-arch);
  }
  .item__nome {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .item__meta {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }
  .item:focus-visible {
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .item:hover .item__foto :global(img),
    .item:focus-visible .item__foto :global(img) {
      transform: scale(1.03);
    }
  }

  /* Vagas: duas grandes lado a lado, depois uma vertical estreita e uma horizontal larga. */
  .vaga--a {
    grid-column: 1 / span 7;
  }
  .vaga--b {
    grid-column: 8 / span 5;
    margin-top: clamp(4rem, 10vw, 9rem);
  }
  .vaga--c {
    grid-column: 2 / span 4;
  }
  .vaga--d {
    grid-column: 7 / span 6;
    align-self: center;
  }

  @media (max-width: 63.99rem) {
    .grade {
      row-gap: clamp(3rem, 10vw, 5rem);
    }
    .vaga {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    /* A vaga vertical estreita mantém a proporção própria também no celular. */
    .vaga--c {
      width: 80%;
    }
  }
</style>
