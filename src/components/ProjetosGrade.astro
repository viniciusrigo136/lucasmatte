---
import { Picture } from 'astro:assets';
import { projectImage, projectMeta, type ProjectData } from '../data/projetos';
import { projectHref } from '../data/site';

/**
 * Grade dos projetos (exceto o destaque), em linhas de dois itens com alternância
 * fixa: 7 + 5 colunas, depois 5 + 7. Nas duas vagas de uma linha a foto tem a mesma
 * altura (a de uma foto 4:5 em 5 colunas), então nomes e categorias ficam alinhados.
 * Os projetos ocupam as vagas na ordem de projetos.ts; o padrão se repete.
 */
interface Props {
  projects: ProjectData[];
}
const { projects } = Astro.props;

// Por item: largura em colunas e, no celular, a proporção própria da foto.
const vagas = [
  { cls: 'vaga--larga', sizes: '(min-width: 64rem) 58vw, 100vw' },
  { cls: 'vaga--estreita', sizes: '(min-width: 64rem) 42vw, 100vw' },
  { cls: 'vaga--estreita', sizes: '(min-width: 64rem) 42vw, 100vw' },
  { cls: 'vaga--larga', sizes: '(min-width: 64rem) 58vw, 100vw' },
];
---

<ul class="wrap grade" role="list">
  {
    projects.map((project, i) => {
      const vaga = vagas[i % vagas.length];
      const capa = project.images.find((im) => im.file === project.cover) ?? project.images[0];
      return (
        <li class:list={['vaga', vaga.cls]}>
          <a href={projectHref(project.slug)} class="item" aria-label={project.title}>
            <span class="item__foto cover">
              <Picture
                src={projectImage(project.slug, capa.file)}
                alt=""
                widths={[480, 720, 960, 1280, 1600]}
                sizes={vaga.sizes}
                formats={['avif', 'webp']}
                quality={72}
                loading="lazy"
                style={`view-transition-name: foto-${project.slug}`}
              />
            </span>
            <span class="item__nome">{project.title}</span>
            <span class="item__meta">{projectMeta(project)}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .grade {
    /* Altura da linha: uma foto 4:5 com 5 colunas de largura. */
    --linha: calc((5 * var(--col) + 4 * var(--grid-gap)) * 5 / 4);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-block);
    margin-block: 0;
    list-style: none;
  }

  .item {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }
  .item__foto {
    display: block;
    height: var(--linha);
    margin-bottom: 0.9rem;
    background: var(--border);
  }
  .item__foto :global(img) {
    transition: transform 1.1s var(--ease-arch);
  }
  .item__nome {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .item__meta {
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }
  .item:focus-visible {
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .item:hover .item__foto :global(img),
    .item:focus-visible .item__foto :global(img) {
      transform: scale(1.03);
    }
  }

  /* Alternância fixa: linha 1 = 7 + 5; linha 2 = 5 + 7. */
  .vaga:nth-child(4n + 1) {
    grid-column: 1 / span 7;
  }
  .vaga:nth-child(4n + 2) {
    grid-column: 8 / span 5;
  }
  .vaga:nth-child(4n + 3) {
    grid-column: 1 / span 5;
  }
  .vaga:nth-child(4n) {
    grid-column: 6 / span 7;
  }

  /* Tablet e celular: uma coluna; cada foto com a proporção da sua vaga. */
  @media (max-width: 63.99rem) {
    .vaga.vaga {
      grid-column: 1 / -1;
    }
    .item__foto {
      height: auto;
    }
    .vaga--larga .item__foto {
      aspect-ratio: 3 / 2;
    }
    .vaga--estreita .item__foto {
      aspect-ratio: 4 / 5;
    }
  }
</style>
