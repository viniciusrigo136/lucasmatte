---
import { Picture } from 'astro:assets';
import { projectImage, projectMeta, type ProjectData } from '../data/projetos';

interface Props {
  project: ProjectData;
  /** Formato da imagem no layout: ampla (paisagem), vertical ou panorâmica. */
  shape: 'wide' | 'tall' | 'pano';
  sizes: string;
  class?: string;
}

const { project, shape, sizes, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cover = project.images.find((i) => i.file === project.cover) ?? project.images[0];
const widths = shape === 'tall' ? [420, 640, 900, 1200] : [640, 960, 1400, 1920, 2400];
---

<article class:list={['card', `card--${shape}`, className]} data-reveal>
  <a href={`${base}/projetos/${project.slug}/`} class="card__link">
    <div class="card__frame">
      <Picture
        src={projectImage(project.slug, cover.file)}
        alt={cover.alt}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        quality={70}
        class="card__img"
      />
    </div>
    <div class="card__caption">
      <h3 class="card__title">{project.title}</h3>
      <p class="card__meta">{projectMeta(project)}</p>
      <p class="card__summary">{project.summary}</p>
      <span class="card__more" aria-hidden="true">Ver projeto</span>
    </div>
  </a>
</article>

<style>
  .card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 2px;
  }
  .card__link:focus-visible {
    outline-offset: 6px;
  }
  .card__frame {
    overflow: hidden;
    background: var(--border);
  }
  .card--wide .card__frame {
    aspect-ratio: 4 / 3;
  }
  .card--tall .card__frame {
    aspect-ratio: 4 / 5;
  }
  .card--pano .card__frame {
    aspect-ratio: 16 / 9;
  }
  .card__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .card__caption {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    align-items: baseline;
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    transition: border-color 0.4s var(--ease-out);
  }
  .card__title {
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .card__meta {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-align: right;
  }
  .card__summary {
    grid-column: 1 / -1;
    max-width: 46ch;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  .card__more {
    grid-column: 1 / -1;
    justify-self: start;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .card__more {
      opacity: 0;
      transform: translateX(-6px);
      transition:
        opacity 0.35s var(--ease-out),
        transform 0.35s var(--ease-out);
    }
    .card__link:hover .card__frame :global(img),
    .card__link:focus-visible .card__frame :global(img) {
      transform: scale(1.03);
    }
    .card__link:hover .card__caption,
    .card__link:focus-visible .card__caption {
      border-color: var(--accent);
    }
    .card__link:hover .card__more,
    .card__link:focus-visible .card__more {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card__frame :global(img) {
      transition: none;
    }
  }
</style>
