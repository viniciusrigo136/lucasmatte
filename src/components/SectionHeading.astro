---
interface Props {
  /** Título dividido em linhas, cada uma em bloco próprio. */
  lines: string[];
  id?: string;
  tone?: 'dark' | 'light';
  class?: string;
}

const { lines, id, tone = 'dark', class: className } = Astro.props;
---

<h2 id={id} class:list={['sh', `sh--${tone}`, className]}>
  {lines.map((l) => <span class="line">{l}</span>)}
</h2>

<style>
  .sh {
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: initial;
  }
  .sh--light {
    color: var(--on-primary);
  }
</style>
