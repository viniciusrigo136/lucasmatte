---
import Logo from './Logo.astro';
import { site, homeHref, secoes } from '../data/site';

const year = new Date().getFullYear();
const { whatsapp, instagram, email } = site.contact;
// Linha institucional: só o que está confirmado em site.ts.
const local = [site.cidade, site.atuacao].filter(Boolean).join(' · ');
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <a href={homeHref} class="site-footer__marca" aria-label="Lucas Matté Arquitetura, página inicial">
      <Logo tone="light" width={220} class="site-footer__logo" />
    </a>

    <nav class="site-footer__secoes" aria-label="Seções">
      <ul>
        {secoes.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>

    <ul class="site-footer__contato">
      {
        whatsapp && (
          <li>
            <a href={whatsapp} target="_blank" rel="noopener">
              WhatsApp<span class="visually-hidden"> (abre em nova aba)</span>
            </a>
          </li>
        )
      }
      <li>
        <a href={instagram.url} target="_blank" rel="noopener">
          Instagram<span class="visually-hidden"> {instagram.handle} (abre em nova aba)</span>
        </a>
      </li>
      {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
    </ul>

    <div class="site-footer__base">
      <p>
        {local}
        {local && site.cau && ' · '}
        {site.cau && <>CAU {site.cau}</>}
      </p>
      <p>© <span data-year>{year}</span> {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--primary);
    color: var(--on-primary);
    padding-block: clamp(3.5rem, 8vw, 6rem) 2rem;
    font-size: var(--step--1);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'marca secoes contato'
      'base base base';
    align-items: start;
    gap: 2.5rem clamp(2rem, 6vw, 6rem);
  }
  .site-footer__marca {
    grid-area: marca;
    display: block;
  }
  .site-footer__marca :global(.site-footer__logo) {
    width: clamp(10rem, 16vw, 13.75rem);
  }
  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__secoes {
    grid-area: secoes;
  }
  .site-footer__secoes ul,
  .site-footer__contato {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }
  .site-footer__contato {
    grid-area: contato;
    justify-content: end;
  }
  .site-footer a:not(.site-footer__marca) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: rgb(243 239 231 / 0.35);
    transition: text-decoration-color 0.3s;
  }
  .site-footer a:not(.site-footer__marca):hover {
    text-decoration-color: currentColor;
  }

  .site-footer__base {
    grid-area: base;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(243 239 231 / 0.14);
    color: var(--on-dark-muted);
  }

  @media (max-width: 63.99rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'marca' 'secoes' 'contato' 'base';
      gap: 1.75rem;
    }
    .site-footer__contato {
      justify-content: start;
    }
    .site-footer__base {
      flex-direction: column;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>
