---
import Logo from './Logo.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <a href={home} class="site-footer__brand" aria-label="Lucas Matté Arquitetura, página inicial">
      <Logo tone="dark" width={180} class="site-footer__logo" />
    </a>

    <nav aria-label="Rodapé">
      <ul class="site-footer__list">
        <li><a href={`${home}#projetos`}>Projetos</a></li>
        <li><a href={`${home}#sobre`}>Sobre</a></li>
        <li><a href={`${home}#atuacao`}>Atuação</a></li>
        <li><a href={`${home}#contato`}>Contato</a></li>
      </ul>
    </nav>

    <ul class="site-footer__list">
      <li>
        <a href={site.contact.instagram.url} target="_blank" rel="noopener">
          Instagram<span class="visually-hidden"> (abre em nova aba)</span>
        </a>
      </li>
      {
        site.contact.whatsapp && (
          <li>
            <a href={site.contact.whatsapp} target="_blank" rel="noopener">
              WhatsApp<span class="visually-hidden"> (abre em nova aba)</span>
            </a>
          </li>
        )
      }
      {site.contact.email && <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>}
    </ul>
  </div>

  <div class="wrap site-footer__base">
    <p>© <span data-year>{year}</span> {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 0.9375rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
    align-items: start;
  }
  .site-footer__brand {
    display: inline-block;
    width: clamp(140px, 14vw, 180px);
  }
  .site-footer__brand :global(.site-footer__logo) {
    width: 100%;
  }
  .site-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    text-decoration: none;
    color: var(--text-secondary);
    transition: color 0.2s;
  }
  .site-footer__list a:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .site-footer__base {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: var(--step--1);
  }
  @media (max-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>
