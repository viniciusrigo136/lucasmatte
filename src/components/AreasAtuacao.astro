---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { getProject, projectImage, projectMeta } from '../data/projetos';
import { areas as definicoes } from '../data/atuacao';

/**
 * Áreas de atuação. No desktop, a lista fica à esquerda e a foto da área ativa à
 * direita: cada área é um botão, e a foto troca ao passar o mouse, focar ou tocar.
 * No celular, cada área mostra a própria foto logo abaixo do texto.
 */
const areas = definicoes.map((a, i) => {
  if (!a.foto) return { ...a, i, foto: undefined };
  const project = getProject(a.foto.slug);
  if (!project) throw new Error(`Atuação: projeto "${a.foto.slug}" não existe.`);
  if (project.category !== a.categoria) {
    throw new Error(`Atuação: a foto de "${a.categoria}" vem de "${project.title}", que é ${project.category}.`);
  }
  const img = project.images.find((im) => im.file === a.foto!.file);
  if (!img) throw new Error(`Atuação: foto ${a.foto.file} não está em ${project.slug}.`);
  return {
    ...a,
    i,
    foto: { src: projectImage(project.slug, img.file), alt: img.alt, legenda: `${project.title} · ${projectMeta(project)}` },
  };
});
---

<section id="atuacao" class="areas" aria-labelledby="atuacao-title" data-areas>
  <div class="wrap areas__grade">
    <div class="areas__lista">
      <SectionHeading lines={['Áreas de', 'atuação']} id="atuacao-title" />
      <ul class="areas__itens">
        {
          areas.map((a) => (
            <li class:list={['area', { 'is-ativa': a.i === 0 }]} data-area={a.i}>
              <h3 class="area__titulo">
                <button type="button" class="area__botao" aria-pressed={a.i === 0 ? 'true' : 'false'} aria-controls="areas-palco">
                  {a.categoria}
                </button>
              </h3>
              <p class="area__texto">{a.texto}</p>
              {a.foto && (
                <figure class="area__foto-movel">
                  <span class="area__moldura cover">
                    <Picture
                      src={a.foto.src}
                      alt={a.foto.alt}
                      widths={[480, 720, 960]}
                      sizes="(max-width: 63.99rem) 100vw, 1px"
                      formats={['avif', 'webp']}
                      quality={70}
                      loading="lazy"
                    />
                  </span>
                  <figcaption>{a.foto.legenda}</figcaption>
                </figure>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Desktop: a foto da área ativa. Só a ativa fica visível e no leitor de tela. -->
    <div class="areas__palco" id="areas-palco">
      {
        areas.map((a) => (
          <figure class:list={['palco', { 'is-ativa': a.i === 0 }]} data-palco={a.i}>
            {a.foto ? (
              <>
                <span class="palco__moldura cover">
                  <Picture
                    src={a.foto.src}
                    alt={a.foto.alt}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 64rem) 36vw, 1px"
                    formats={['avif', 'webp']}
                    quality={72}
                    loading="lazy"
                  />
                </span>
                <figcaption>{a.foto.legenda}</figcaption>
              </>
            ) : (
              <span class="palco__moldura palco__moldura--texto" aria-hidden="true">
                <span>{a.categoria}</span>
              </span>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .areas {
    padding-block: var(--space-block);
  }
  .areas__grade {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
  }
  .areas__lista {
    grid-column: 1 / span 6;
    display: grid;
    align-content: start;
    gap: var(--space-block);
  }
  .areas__itens {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .area {
    padding-block: var(--space-text);
    border-bottom: 1px solid var(--border);
  }
  .area__titulo {
    margin: 0;
    font: inherit;
  }
  .area__botao {
    display: block;
    width: 100%;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-align: left;
    cursor: pointer;
  }
  .area__texto {
    max-width: 40ch;
    margin-top: 0.75rem;
    color: var(--text-secondary);
  }
  /* A área ativa ganha um fio sob o título; as outras ficam como estão. */
  .area.is-ativa .area__botao {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--link-line, var(--bronze-on-light));
  }

  .areas__palco {
    grid-column: 8 / span 5;
    position: sticky;
    top: calc(var(--header-h-compact) + 2rem);
    align-self: start;
    display: grid;
  }
  .palco {
    grid-area: 1 / 1;
    margin: 0;
    visibility: hidden;
    opacity: 0;
  }
  .palco.is-ativa {
    visibility: visible;
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .palco {
      transition:
        opacity 0.5s var(--ease-arch),
        visibility 0.5s;
    }
  }
  .palco__moldura,
  .area__moldura {
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--border);
  }
  .palco__moldura--texto {
    display: grid;
    place-items: center;
    background: var(--primary);
    color: var(--on-primary);
    font-family: var(--font-serif);
    font-size: var(--step-3);
  }
  .palco figcaption,
  .area__foto-movel figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }
  .area__foto-movel {
    display: none;
    margin: 1.5rem 0 0;
  }

  @media (max-width: 63.99rem) {
    .areas__lista {
      grid-column: 1 / -1;
    }
    .areas__palco {
      display: none;
    }
    .area__foto-movel {
      display: block;
    }
    .area__moldura {
      aspect-ratio: 4 / 3;
    }
    /* No celular não há foto para trocar: o título não precisa de destaque. */
    .area.is-ativa .area__botao {
      text-decoration: none;
    }
    .area__botao {
      cursor: default;
    }
  }
</style>

<script>
  const secao = document.querySelector<HTMLElement>('[data-areas]');
  if (secao) {
    const itens = Array.from(secao.querySelectorAll<HTMLElement>('[data-area]'));
    const palcos = Array.from(secao.querySelectorAll<HTMLElement>('[data-palco]'));
    const ativa = (i: number) => {
      itens.forEach((it, k) => {
        it.classList.toggle('is-ativa', k === i);
        it.querySelector('button')!.setAttribute('aria-pressed', String(k === i));
      });
      palcos.forEach((p, k) => p.classList.toggle('is-ativa', k === i));
    };
    itens.forEach((it, i) => {
      const botao = it.querySelector('button')!;
      it.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') ativa(i);
      });
      botao.addEventListener('focus', () => ativa(i));
      botao.addEventListener('click', () => ativa(i));
    });
  }
</script>
