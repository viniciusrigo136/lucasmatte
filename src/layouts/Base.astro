---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Header transparente sobre a hero. */
  overlayHeader?: boolean;
}

const { title = site.title, description = site.description, ogImage, overlayHeader = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#302D29" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Garantia: se a animação não rodar, o conteúdo aparece mesmo assim.
      setTimeout(() => { if (!window.__lmMotion) document.documentElement.classList.add('motion-done'); }, 2500);
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header overlay={overlayHeader} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <script>
      import { animate, inView } from 'motion';

      (window as unknown as { __lmMotion: boolean }).__lmMotion = true;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        inView(
          '[data-reveal]',
          (el) => {
            animate(el, { opacity: [0, 1], transform: ['translateY(18px)', 'translateY(0)'] }, {
              duration: 0.7,
              ease: [0.22, 1, 0.36, 1],
            });
          },
          { amount: 0.2 },
        );
      }
    </script>
  </body>
</html>

<style is:global>
  .motion-done [data-reveal] {
    opacity: 1 !important;
    transform: none !important;
  }
</style>
