---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Header claro sobre uma foto no topo da página. */
  overlayHeader?: boolean;
  /** A página abre com a logo grande no hero: a logo do header só aparece ao rolar. */
  heroLogo?: boolean;
  /** Tema da página: 'dark' troca as variáveis de cor para o preto do Decorare. */
  theme?: 'light' | 'dark';
}

const { title = site.title, description = site.description, ogImage, overlayHeader = false, heroLogo = false, theme = 'light' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'dark' ? '#000000' : '#302D29'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    {
      heroLogo && (
        <script is:inline>
          // Entrada do hero: só na primeira visita da sessão e sem preferência por menos
          // movimento. Decidido aqui, antes da primeira pintura. Se o script do hero não
          // começar em 3s, tudo aparece pronto.
          (function () {
            var root = document.documentElement;
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            try {
              if (sessionStorage.getItem('lm-hero-intro')) return;
              sessionStorage.setItem('lm-hero-intro', '1');
            } catch (e) {}
            root.classList.add('hero-intro');
            setTimeout(function () {
              if (!window.__lmHeroIntro) root.classList.remove('hero-intro');
            }, 3000);
          })();
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body data-theme={theme === 'dark' ? 'dark' : undefined}>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header overlay={overlayHeader} heroLogo={heroLogo} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
